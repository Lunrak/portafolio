{
	"compilerOptions": {
		"rootDir": "./src",
		"outDir": "./dist",
		"module": "esnext",
		"target": "esnext",
		"lib": ["esnext", "dom"],
		"types": [],
		"noUncheckedIndexedAccess": true,
		"exactOptionalPropertyTypes": true,
		"strict": true,
		"isolatedModules": true,
		"moduleDetection": "force",
		"skipLibCheck": true
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules", "dist"]
}